Bootstrap: docker
From: ubuntu:22.04

%environment
    ROS_DISTRO=humble
    DEBIAN_FRONTEND=noninteractive

%post
    apt update && apt install -y software-properties-common lsb-release curl git wget gnupg
    add-apt-repository universe -y
    ROS_APT_SOURCE_VERSION=$(
    curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest \
    | grep -F '"tag_name"' | awk -F\" '{print $4}')
    OS_CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
    curl -L -o /tmp/ros2-apt-source.deb \
    "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.${OS_CODENAME}_all.deb"

    apt install -y /tmp/ros2-apt-source.deb
    apt update && apt upgrade -y
    apt install -y ros-humble-ros-base ros-dev-tools
    mkdir -p /etc/apt/keyrings

    curl -fsSL https://packages.osrfoundation.org/gazebo.key \
    | gpg --dearmor -o /etc/apt/keyrings/gazebo.gpg
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/gazebo.gpg] \
    http://packages.osrfoundation.org/gazebo/ubuntu-stable ${OS_CODENAME} main" \
    > /etc/apt/sources.list.d/gazebo-stable.list
    apt update && apt install -y \
    gazebo \
    libgazebo-dev \
    libignition-gazebo6 \
    libignition-gazebo6-dev \
    libignition-gazebo6-plugins \
    libgz-plugin2-dev \
    ros-humble-ros-gz-bridge \
    ros-humble-slam-toolbox \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup 

    apt install python3 python3-pip -y
    pip3 install torch torchvision
    mkdir -p /ros_ws/ && cd /ros_ws/ && git clone --single-branch --branch new_gen_swarm https://github.com/Jakuko99/robot-node-ros2.git src
    source /opt/ros/humble/setup.bash && colcon build --symlink-install

%runscript
    cd /ros_ws/src && git pull
    cd .. && source install/setup.bash
    colcon build --symlink-install
    source install/setup.bash
    python3 src/run_model_training.py

%labels
    Author jakub.krsko@feit.uniza.sk
    Version 1.0
    Description ROS 2 environment for training navigation models in simulation